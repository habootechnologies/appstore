    <!-- Hourly: Fetch latest (limited) -->
    <record id="google_review_cron_hourly" model="ir.cron">
        <field name="name">Google Review Fetch (Hourly - Limited)</field>
        <field name="model_id" ref="model_google_review"/>
        <field name="state">code</field>
        <field name="code">model.get_google_reviews('limit')</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

    <!-- Weekly: Fetch all -->
    <record id="google_review_cron_weekly" model="ir.cron">
        <field name="name">Google Review Fetch (Weekly - Full)</field>
        <field name="model_id" ref="model_google_review"/>
        <field name="state">code</field>
        <field name="code">model.get_google_reviews('full')</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">False</field>

    </record>

</odoo>

