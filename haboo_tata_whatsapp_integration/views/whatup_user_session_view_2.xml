<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_whatup_user_session_2_tree" model="ir.ui.view">
        <field name="name">whatup.user.session.2.tree</field>
        <field name="model">whatup.user.session.2</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_whatup_user_session_2_form" model="ir.ui.view">
        <field name="name">whatup.user.session.2.form</field>
        <field name="model">whatup.user.session.2</field>
        <field name="arch" type="xml">
            <form string="WhatsApp User Session 2">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatup_user_session_2" model="ir.actions.act_window">
        <field name="name">WhatsApp User Sessions 2</field>
        <field name="res_model">whatup.user.session.2</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_whatup_user_session_2"
              name="User Sessions 2"
              parent="crm.crm_menu_sales"
              action="action_whatup_user_session_2"
              groups="haboo_tata_whatsapp_integration.group_session_2_user"
              sequence="21"/>
</odoo>
