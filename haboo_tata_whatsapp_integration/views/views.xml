<odoo>
    <data>
        <record id="tata_whatsapp_filters_view_search" model="ir.ui.view">
            <field name="name">Tata Whatsapp Session View Search</field>
            <field name="model">tata.whatsapp.session</field>
            <field name="arch" type="xml">
                <search>
                    <field name="customer_name"/>
                    <field name="customer_number"/>
                    <field name="agent_user_id"/>
                </search>
            </field>
        </record>


        <record id="tata_whatsapp_session_form_view" model="ir.ui.view">
            <field name="name">Tata Whatsapp Session View Form</field>
            <field name="model">tata.whatsapp.session</field>
            <field name="arch" type="xml">
                <form string="Whatsapp Session">
                    <header>
                        <button name="create_opportunity_wizard" string="Convert to Opportunity" invisible="state != 'running'" type="object" class="oe_highlight"/>
                        <button name="close_session" string="Close Session" invisible="is_close_visible == False" type="object" class="oe_highlight"/>
                        <button name="start_session" string="Start Session" invisible="state != 'new'" type="object" class="oe_highlight"/>
                        <button name="reopen_session" string="Start Session" invisible="state != 'close'" type="object" class="oe_highlight"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,running,close" readonly="1"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_opportunity" type="object" string="Opportunity" class="oe_stat_button"/>
                        </div>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <!-- <field name="customer_name" readonly="1"/>
                            <field name="customer_number" readonly="1"/> -->
                            <field name="customer_name" readonly="state != 'new'"/>
                            <field name="customer_number" readonly="state != 'new'"/>
                            <field name="date" readonly="1"/>
                            <field name="agent_user_id"/>
                            <field name="sess_id" readonly="1"/>
                            <field name="opportunity_id" readonly="1"/>
                            <field name="last_massage_datetime" readonly="1"/>
                            <field name="is_close_visible" invisible="1"/>
                            <field name="is_gen_con"/>
                            <field name="remarks"
                                   required="is_gen_con == True"/>

                            <field name="new_opporunity" invisible="1"/>
                        </group>
                        <notebook>
                            <page name="session_messages" invisible="state == 'close'" string="Messages">
                               <!-- <div style="align-items: center;text-align: left;width: 100%;max-width: 100%;align:center;padding-left: 250px;padding-right: 250px;">
                                    <field name="session_messages" t-attf-style="background-color: #A9A9A9 if message_text else #D3D3D3;">
                                        <list editable="bottom" create="0" edit="0" delete="0" open="0">
                                            <field name="message_text" readonly="1" nolabel="1"/>
                                            <field name="send_message" style="max-width:300px;" readonly="message_text != False" nolabel="1"/>
                                           <button name="action_send_message" type="object" string="Send" invisible="message_text != False"/>
                                        </list>
                                        <form>
                                            <group>
                                                <field name="customer_name" readonly="1"/>
                                                <field name="customer_number" readonly="1"/>
                                                 <field name="message_type" readonly="1"/>
                                                <field name="message_text" readonly="1"/>
                                                <field name="message_date" readonly="1"/>
                                            </group>
                                        </form>
                                    </field>
                                </div> -->
                                <div class="o_row" style="align:center;width:50%;">
                                    <field name="send_message" invisible="state == 'close'" placeholder="Type your Message here" nolabel="1"/>
                                    <field name="file_name" invisible="1"/>
                                    <field name="product_image" filename="file_name"/>
                                    <!-- <button name="action_send_message" invisible="state == 'close'" class="oe_highlight" type="object" string="Send Message"/> -->
                                    <button 
                                        name="action_send_message" 
                                        invisible="state == 'close'"  
                                        type="object"
                                        id="wp_button" 
                                        style="background-color: #1fb141 !important; border: none; padding: 0;">
                                        <img src="/haboo_tata_whatsapp_integration/static/src/img/wp.png" alt="Send Message" style="height: 12px; width: 20px;"/> Send Message 
                                    </button>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <!-- added the decoration for the view in the tree view -->
        <record id="tata_whatsapp_session_tree_view" model="ir.ui.view">
            <field name="name">Tata Whatsapp Session View Tree</field>
            <field name="model">tata.whatsapp.session</field>
            <field name="arch" type="xml">
                <list decoration-info="message_needaction">
                    <field name="date"/>
                    <field name="customer_name"/>
                    <field name="agent_user_id"/>
                    <field name="customer_number"/>
                    <field name="last_massage_datetime" string="Last Message"/>
                    <field name="state"/>
                    <field name="message_needaction" invisible="1"/>
                    <field name="message_needaction_counter" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="action_tata_whatsapp_session" model="ir.actions.act_window">
            <field name="name">Tata Whatsapp Session</field>
            <field name="res_model">tata.whatsapp.session</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="tata_whatsapp_session_menu"
            name="Tata Whatsapp Session"
            parent="crm.crm_menu_sales"
            action="action_tata_whatsapp_session"
            groups="haboo_tata_whatsapp_integration.group_whatsapp_session_user"
            sequence="2"
        />

        <record model="ir.ui.view" id="res_config_settings_view_tata_auto_close_session_form">
            <field name="name">Auto close session settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                    <h2>Auto Close Session</h2>
                    <div class="row mt16 o_settings_container" name="tata_auto_close_setting_container">
                        <div class="content-group">
                            <div class="row">
                                <label for="auto_close_minute" class="col-lg-4 o_light_label"/>
                                <field name="auto_close_minute" class="col-lg-4 o_light_label"/>minutes
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
        <record model="ir.ui.view" id="res_config_settings_view_tata_add_whatup_token">
            <field name="name">Session Token</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                    <h2>Session Token</h2>
                    <div class="row mt16 o_settings_container" name="settings_view_tata_add_whatup_token_container">
                        <div class="content-group">
                            <div class="row">
                                <label for="session_token" class="col-lg-4 o_light_label"/>
                                <field name="session_token" class="col-lg-4 o_light_label"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>


    </data>
</odoo>