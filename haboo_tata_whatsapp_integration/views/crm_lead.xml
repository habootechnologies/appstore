<odoo>
    <data>

        <record id="crm_lead_form_view_inherited" model="ir.ui.view">
            <field name="name">CRM Lead FOrm View Inherited</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='phone']" position="after">
                    <field name="whatsapp_session_id" readonly="1" invisible="1"/>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="new_whatsapp_session" type="object" class="oe_stat_button"  string="Send Whatsapp Message" invisible="type != 'opportunity'"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="view_whatsapp_session" type="object" class="oe_stat_button" string="Whatsapp Session" invisible="whatsapp_session_id == False"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>