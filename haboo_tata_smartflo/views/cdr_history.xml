<odoo>
    <data>
        <record id="cdr_history_filters_view_search" model="ir.ui.view">
            <field name="name">
                cdr.history.search
            </field>
            <field name="model">
                cdr.history
            </field>
            <field name="arch" type="xml">
                <search>
                    <field name="agent_number"/>
                    <field name="client_number"/>
                    <field name="department_name"/>
                    <filter name="filter_answered_calls" string="Answered Calls" domain="[('call_status', '=', 'answered')]"/>
                    <group>
                        <filter name="group_by_agent" string="Agent" context="{'group_by': 'agent_number'}"/>
                        <filter name="group_by_department" string="Department" context="{'group_by': 'department_name'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="cdr_history_form_view" model="ir.ui.view">
            <field name="name">
                CDR History View Form
            </field>
            <field name="model">
                cdr.history
            </field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="create_opportunity_wizard" type="object" class="oe_highlight" string="Convert to Opportunity"/>
                        <field name="call_status" widget="statusbar" options="{'clickable': 0}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_opportunity" type="object" class="oe_stat_button" string="Opportunity"/>
                        </div>
                        <group colspan="4">
                            <group>
                                <field name="log_id" readonly="1"/>
                                <field name="call_id" readonly="1"/>
                                <field name="call_direction" readonly="1"/>
                                <field name="call_description" readonly="1"/>
                                <field name="call_recording_url" widget="url" readonly="1"/>
                                <field name="call_date" readonly="1"/>
                                <field name="call_region" readonly="1"/>
                                <field name="sla_boo"/>
                                <field name="call_duration" style="width:100px;" readonly="1"/>
                                <label for="notes"/>
                                <div class="o_row">
                                    <field name="notes"/>
                                    <button name="update_notes" type="object" class="oe_highlight" string="Update"/>
                                </div>
                            </group>
                            <group>
                                <field name="department_name" readonly="1"/>
                                <field name="agent_name" readonly="1"/>
                                <field name="agent_number"/>
                                <field name="client_number" force_save="1"/>
                                <field name="client_id" readonly="1"/>
                                <field name="general_conversation"/>
                                <field name="remark" attrs="{'required': [('general_conversation', '=', True)]}"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="cdr_history_tree_view" model="ir.ui.view">
            <field name="name">
                CDR History View Tree
            </field>
            <field name="model">
                cdr.history
            </field>
            <field name="arch" type="xml">
                <tree create="false" default_order="call_date desc">
                    <field name="department_name"/>
                    <field name="call_region"/>
                    <field name="call_date"/>
                    <field name="agent_number"/>
                    <field name="client_number"/>
                    <field name="agent_name"/>
                    <field name="client_id"/>
                    <field name="agent_user_id" invisible="1"/>
                    <field name="call_status"/>
                </tree>
            </field>
        </record>
        <record id="action_cdr_history" model="ir.actions.act_window">
            <field name="name">
                CDR History
            </field>
            <field name="res_model">
                cdr.history
            </field>
            <field name="view_mode">
                list,form
            </field>
            <field name="context">
                {'search_default_filter_answered_calls': 1}
            </field>
        </record>
        <menuitem id="cdr_history_menu" name="CDR History" groups="haboo_tata_smartflo.group_tata_session_user" parent="crm.crm_menu_sales" action="action_cdr_history" sequence="1"/>
        <record id="res_view_users_form_inherit" model="ir.ui.view">
            <field name="name">
                res.users.inherit.form
            </field>
            <field name="model">
                res.users
            </field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="before">
                    <group string="Contact">
                        <field name="phone"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
