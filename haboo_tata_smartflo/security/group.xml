<odoo>
    <record id="group_tata_session_user" model="res.groups">
        <field name="name">Tata Smartflo Session User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tata_session_manager" model="res.groups">
        <field name="name">Tata Smartflo Session Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_tata_session_user'))]"/>
    </record>

    <record id="rule_agent_user" model="ir.rule">
        <field name="name">Rule Agent User</field>
        <field name="model_id" ref="haboo_tata_smartflo.model_cdr_history"/>
        <field name="domain_force">[('agent_number', '=', user.phone)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_manager_all_cdrs" model="ir.rule">
        <field name="name">Managers See All CDRs</field>
        <field name="model_id" ref="haboo_tata_smartflo.model_cdr_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(4, ref('haboo_tata_smartflo.group_tata_session_manager'))]"/>
    </record>
</odoo>
