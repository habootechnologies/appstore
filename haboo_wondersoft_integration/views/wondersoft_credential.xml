<odoo>
    <data>

        <record id="wondersoft_credential_form_view" model="ir.ui.view">
            <field name="name">Wondersoft View Form</field>
            <field name="model">wondersoft.credential</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group colspan="4">
                            <group>
                                <field name="wondersoft_access_token" readonly="1"/>
                                <field name="wondersoft_access_token_url" readonly="1"/>
<!--                                <field name="call_direction" readonly="1"/>-->
<!--                                <field name="call_description" readonly="1"/>-->
<!--                                <field name="call_recording_url" widget="url" readonly="1"/>-->
<!--                                <field name="call_date" readonly="1"/>-->
<!--                                <field name="call_region" readonly="1"/>-->
<!--                                <field name="call_duration" style="width:100px;" readonly="1"/>-->
<!--                                <label for="notes"/>-->
                            </group>
                            <group>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wondersoft_credential_tree_view" model="ir.ui.view">
            <field name="name">Wondersoft View Tree</field>
            <field name="model">wondersoft.credential</field>
            <field name="arch" type="xml">
                <list>
                    <field name="wondersoft_access_token_url"/>
                    <field name="wondersoft_access_token"/>

                </list>
            </field>
        </record>

        <record id="action_wondersoft_credential" model="ir.actions.act_window">
            <field name="name">Wondersoft Credential</field>
            <field name="res_model">wondersoft.credential</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="wondersoft_credential_menu"
            name="Wonder Soft Credential"
            parent="crm.crm_menu_root"
            action="action_wondersoft_credential"
            sequence="3"
        />
    </data>
</odoo>