<odoo>
    <data>

        <record model="ir.ui.view" id="res_config_settings_view_wondersoft_integration_form">
            <field name="name">View WonderSoft Integration Configuration Settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                        <h2>WonderSoft API Configuration</h2>
                        <div class="row mt16 o_settings_container" name="wondersoft_integration_setting_container">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="wondersoft_access_token_url" class="col-lg-4 o_light_label"/>
                                    <field name="wondersoft_access_token_url"/>
                                </div>
                                <div class="row mt16">
                                    <label for="wondersoft_access_token" class="col-lg-4 o_light_label"/>
                                    <field name="wondersoft_access_token"/>
                                </div>
                            </div>
                        </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>