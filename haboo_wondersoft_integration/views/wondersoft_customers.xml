<odoo>
    <data>

        <record id="res_partner_inherit_form" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.view</field>
            <field name="model">res.partner</field>
             <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="wondersoft_customer" readonly="1"/>
                <field name="wondersoft_id" invisible="0"/>
                <field name="created_date" readonly="1"/>
                <field name="modified_date" readonly="1"/>
            </xpath>
            </field>
        </record>
    </data>
</odoo>