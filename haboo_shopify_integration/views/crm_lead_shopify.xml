<odoo>
    <data>
        <record id="crm_lead__shopify_view_form_inherited" model="ir.ui.view">
            <field name="name">
                Crm Lead Shopify Form View Inherited
            </field>
            <field name="model">
                crm.lead
            </field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='expected_revenue']" position="after">
                    <label for="shopify_order_no" attrs="{'invisible': [('from_conversion_shopify', '=', False)]}"/>
                    <div class="o_row" attrs="{'invisible': [('from_conversion_shopify', '=', False)]}">
                        <field name="shopify_order_no"/>
                        <button name="update_sale_order" type="object" class="oe_highlight" string="Update"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
