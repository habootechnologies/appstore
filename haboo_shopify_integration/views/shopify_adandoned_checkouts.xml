<odoo>
    <data>
        <record id="shopify_adandoned_checkouts_filters_view_search" model="ir.ui.view">
            <field name="name">
                abandoned.checkouts.search
            </field>
            <field name="model">
                abandoned.checkouts
            </field>
            <field name="arch" type="xml">
                <search>
                    <field name="shopify_customer"/>
                </search>
            </field>
        </record>
        <record id="abandoned_checkouts_form_views" model="ir.ui.view">
            <field name="name">
                Abandoned Checkouts View Form
            </field>
            <field name="model">
                abandoned.checkouts
            </field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="create_opportunity_wizard" type="object" string="Convert to Opportunity" class="oe_highlight" attrs="{'invisible': [('is_boolean', '!=', True)]}"/>
                        <field name="state" widget="statusbar" options="{'clickable': 0}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_opportunity" type="object" class="oe_stat_button" string="Opportunity"/>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="shopify_customer" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="country" readonly="1"/>
                            <field name="country_code" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="is_boolean" invisible="1"/>
                        </group>
                        <notebook>
                            <page name="abandoned_checkouts_lines_ids" string="Checkouts Order Lines">
                                <field name="abandoned_checkouts_lines_ids">
                                    <tree name="abandoned_checkouts_lines_ids" editable="bottom" delete="false" create="false">
                                        <field name="shopify_product_template_id"/>
                                        <field name="sku_code" string="SKU"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                        <field name="product_uom_id" readonly="1"/>
                                        <field name="price_total"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="company_currency_id" invisible="1"/>
                                    <div class="o_row">
                                        <label for="price_subtotal" string="Total"/>
                                        <field name="price_subtotal" options="{'currency_field': 'company_currency_id'}"/>
                                    </div>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="abandoned_checkouts_tree_views" model="ir.ui.view">
            <field name="name">
                Abandoned Checkouts View Tree
            </field>
            <field name="model">
                abandoned.checkouts
            </field>
            <field name="arch" type="xml">
                <tree default_order="date desc">
                    <field name="name"/>
                    <field name="shopify_customer"/>
                    <field name="date"/>
                    <field name="state"/>
                    <field name="country"/>
                </tree>
            </field>
        </record>
        <record id="action_abandoned_checkouts" model="ir.actions.act_window">
            <field name="name">
                Abandoned Checkouts
            </field>
            <field name="res_model">
                abandoned.checkouts
            </field>
            <field name="view_mode">
                list,form
            </field>
        </record>
        <menuitem id="abandoned_checkouts_menu" name="Abandoned Checkouts" parent="sale.sale_order_menu" action="action_abandoned_checkouts" sequence="21"/>
    </data>
</odoo>
