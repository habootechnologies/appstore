<odoo>
    <data>

        <record model="ir.ui.view" id="res_config_settings_view_shopify_integration_form">
            <field name="name">View Shopify Integration Configuration Settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                        <h2>Shopify API Configuration</h2>
                        <div class="row mt16 o_settings_container" name="shopify_integration_setting_container">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="shopify_access_token" class="col-lg-4 o_light_label"/>
                                    <field name="shopify_access_token"/>
                                </div>
                                <div class="row mt16">
                                    <label for="shopify_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="shopify_api_key"/>
                                </div>
                                <div class="row mt16">
                                    <label for="shopify_shop_name" class="col-lg-4 o_light_label"/>
                                    <field name="shopify_shop_name"/>
                                </div>
                                <div class="row mt16">
                                    <label for="shopify_version" class="col-lg-4 o_light_label"/>
                                    <field name="shopify_version"/>
                                </div>

                            </div>
                        </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>