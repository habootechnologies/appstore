<odoo>
    <data>
        <record id="res_config_settings_view_instagram_post" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.instagram.posts</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='invite_users']" position="inside">
                    <h2>Instagram | Facebook Post Fetch Limit</h2>
                    <div class="row mt16 o_settings_container" id="instagram_post_limit">
                        <div class="col-12 col-lg-6 o_setting_box" id="instagram_post_limit">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Fetch Limit</span>
                                <div class="text-muted">
                                    Fetch post limit
                                </div>
                                <div class="text-muted">
                                    <field name="instagram_post_limit"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </xpath>
            </field>
        </record>



        <!-- Hourly: Fetch latest (limited) -->
        <record id="instagram_post_comments_cron_limit" model="ir.cron">
            <field name="name">Instagram Comment | post Fetch (Limited)</field>
            <field name="model_id" ref="model_post_post"/>
            <field name="state">code</field>
            <field name="code">model.get_post_and_comments('limit', "instagram")</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

        <!-- Weekly: Fetch all -->
        <record id="instagram_post_comments_cron_full" model="ir.cron">
            <field name="name">Instagram Comment | post Fetch ( Full)</field>
            <field name="model_id" ref="model_post_post"/>
            <field name="state">code</field>
            <field name="code">model.get_post_and_comments('full', "instagram")</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">False</field>

        </record>


        <!-- Hourly: Fetch latest (limited) -->
        <record id="facebook_post_comments_cron_limit" model="ir.cron">
            <field name="name">Facebook Comment | post Fetch (Limited)</field>
            <field name="model_id" ref="model_post_post"/>
            <field name="state">code</field>
            <field name="code">model.get_post_and_comments('limit', "facebook")</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

        <!-- Weekly: Fetch all -->
        <record id="facebook_post_comments_cron_full" model="ir.cron">
            <field name="name">Facebook Comment | post Fetch ( Full)</field>
            <field name="model_id" ref="model_post_post"/>
            <field name="state">code</field>
            <field name="code">model.get_post_and_comments('full', "facebook")</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">False</field>

        </record>

        <!-- Instagram Post Form View -->
        <record id="view_instagram_post_form" model="ir.ui.view">
            <field name="name">post.post.form</field>
            <field name="model">post.post</field>
            <field name="arch" type="xml">
                <form string="Post">
                    <header>
                            <button name="fetch_comments"
                                    string="Fetch Comments"
                                    type="object"
                                    class="oe_highlight"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="caption"/>
                            <field name="post_id"/>
<!--                             <field name="media_url"/> -->
                            <field name="permalink"/>
                            <field name="media_type"/>
                            <field name="meta_platform"/>
                            <field name="is_sponsored"/>
                            <field name="owner"  invisible="1"/>
                            <field name="username"/>

                            <!-- Then show the One2many comments -->
                        </group>
                        <notebook>
                            <page string="Comments" name="comments">
                                <field name="comment_ids" >
                                    <list editable="bottom">
                                        <field name="text"/>
                                        <field name="username" />
                                        <field name="timestamp"/>
                                        <field name="reply_text"/>
                                        <field name="partner_id" invisible="1"/>
                                        <field name="opportunity_id" invisible="1"/>
                                        <button name="send_reply_to_instagram" 
                                                string="Reply" 
                                                type="object" 
                                                class="oe_highlight"/>
                                        <button name="create_opportunity_wizard" 
                                            string="Convert to Opportunity" 
                                            invisible="opportunity_id != False" 
                                            type="object"
                                            class="oe_highlight"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="reply_ids">
                                            <list editable="bottom">
                                                <field name="text"/>
                                                <field name="username"/>
                                                <field name="timestamp"/>
                                                <button name="delete_reply" 
                                                        string="Delete Reply" 
                                                        type="object" 
                                                        class="oe_highlight"/>
                                            </list>
                                        </field>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Post Media Details" name="post_information">
                               <field name="thumbnail_url" widget="image_url" invisible="media_type != 'VIDEO'"/>
                                <field name="media_url" widget="image_url" invisible="media_type == 'VIDEO'"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Instagram Post Tree View -->
        <record id="view_instagram_post_tree" model="ir.ui.view">
            <field name="name">post.post.tree</field>
            <field name="model">post.post</field>
            <field name="arch" type="xml">
                <list string="Posts" default_order="latest_comment_timestamp desc">
                    <field name="caption_first_line" string="Caption"/>
                    <field name="media_url"/>
                    <field name="meta_platform"/>
                    <field name="latest_comment_timestamp" string="Latest Comment"/>
                    <field name="all_comment_texts" readonly="1"/>
                    <field name="is_sponsored"/>
                </list>
            </field>
        </record>


        <!-- Action for Instagram Posts -->
        <record id="action_instagram_posts" model="ir.actions.act_window">
            <field name="name">Instagram | Facebook Feed</field>
            <field name="res_model">post.post</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_instagram_post_tree"/>
            <field name="context">{'search_default_order': 'latest_comment_timestamp desc'}</field>
        </record>

        <!-- Menu item -->
        <menuitem
            id="menu_instagram_feed"
            name="Instagram | Facebook Feed"
            parent="messenger_menu"
            action="action_instagram_posts"
            sequence="10"/>
    </data>
</odoo>
